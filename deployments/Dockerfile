# 빌드 context는 레포 루트다: docker build -f deployments/Dockerfile .
# 베이스 이미지는 태그@digest로 고정한다 (GPU-292). 올릴 때: docker buildx imagetools inspect <이미지:태그>
FROM golang:1.27@sha256:5f1b98fa02fe396ebce2a0227a0e08309e11792915b9dd2e1f71053d7e7e6666 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/api ./cmd/api

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/api /api
EXPOSE 8080
ENTRYPOINT ["/api"]
